{
    "default_provider": "ollama",
    "fallback_provider": "ollama",
    "stream_output": false,
    "attachment_max_chars": 20000,
    "active_project": "asia",

    "ollama_host": "http://localhost:11434",
    "ollama_model": "qwen2.5-coder:7b",
    "intent_model": "qwen2.5-coder:7b",
    "models_by_domain": {
        "code": "qwen2.5-coder:7b",
        "math": "qwen3:4b",
        "general": "qwen2.5-coder:7b"
    },
    "ollama_one_model_at_a_time": true,
    "think_domains": ["math"],

    "external_allow_memory": false,
    "trusted_local_hosts": [],
    "external_secret_policy": "redact",
    "ollama_num_ctx": 16384,
    "ollama_temperature": 0.1,
    "ollama_repeat_penalty": 1.15,
    "embedding_model": "nomic-embed-text",
    "embedding_timeout": 120,
    "gemini_model": "gemini-2.5-flash",

    "provider_aliases": {
        "olama": "ollama",
        "ollana": "ollama"
    },
    "project_aliases": {
        "bolitabot": "pt"
    },

    "ignored_dirs": [
        ".git", ".idea", ".vscode",
        "__pycache__", ".venv", "venv", "env", ".pytest_cache",
        "node_modules",
        "target", "build", ".gradle", ".m2",
        "bin", "obj",
        "backups", "chroma_db"
    ],
    "test_dirs": ["test", "tests", "pruebas"],
    "review_ignored_dirs": [".github", ".devcontainer"],
    "review_project_synthesis": true,
    "allowed_imports": [],
    "sandbox_timeout": 20,
    "sandbox_max_output": 4000,

    "code_extensions": [
        ".py", ".java", ".kt", ".js", ".jsx", ".ts", ".tsx",
        ".c", ".cpp", ".h", ".hpp", ".cs", ".go", ".rs", ".rb", ".php",
        ".m", ".dart", ".swift", ".sh", ".ps1", ".sql"
    ],
    "text_extensions": [
        ".md", ".txt", ".json", ".yaml", ".yml", ".toml", ".xml",
        ".gradle", ".properties", ".ini", ".cfg",
        ".html", ".css", ".sdf", ".urdf", ".launch"
    ],

    "context_limits": {
        "summarize_file": 6000,
        "explain_file": 8000,
        "review_file": 10000,
        "generate_code_file": 12000,
        "review_project_file": 3000,
        "review_project_files": 15,
        "debug_project_tokens": 6000,
        "summarize_folder": {"max_files": 12, "max_chars_per_file": 1200},
        "save_project_summary": {"max_files": 15, "max_chars_per_file": 1500},
        "map_project": {"max_files": 30, "max_chars_per_file": 800},
        "generate_code_project": {"max_files": 25, "max_chars_per_file": 800}
    }
}
