{
    "default_provider": "ollama",
    "fallback_provider": "ollama",
    "stream_output": true,
    "attachment_max_chars": 20000,
    "active_project": "asia",

    "ollama_host": "http://localhost:11434",
    "ollama_model": "qwen2.5-coder:7b",
    "intent_model": "qwen2.5-coder:7b",
    "models_by_domain": {
        "code": "qwen2.5-coder:7b",
        "math": "qwen3:4b",
        "general": "qwen2.5-coder:7b"
    },
    "ollama_one_model_at_a_time": true,
    "think_domains": ["math"],

    "external_allow_memory": false,
    "trusted_local_hosts": [],
    "external_secret_policy": "redact",
    "open_mode_default": false,
    "ollama_num_ctx": 16384,
    "ollama_temperature": 0.1,
    "ollama_repeat_penalty": 1.15,
    "embedding_model": "nomic-embed-text",
    "embedding_timeout": 120,
    "gemini_model": "gemini-2.5-flash",

    "provider_aliases": {
        "olama": "ollama",
        "ollana": "ollama"
    },
    "project_aliases": {
        "bolitabot": "pt"
    },

    "ignored_dirs": [
        ".git", ".idea", ".vscode",
        "__pycache__", ".venv", "venv", "env", ".pytest_cache",
        "node_modules",
        "target", "build", ".gradle", ".m2",
        "bin", "obj",
        "backups", "chroma_db"
    ],
    "test_dirs": ["test", "tests", "pruebas"],
    "review_ignored_dirs": [".github", ".devcontainer"],
    "review_project_synthesis": true,
    "allowed_imports": [],
    "sandbox_timeout": 20,
    "sandbox_max_output": 4000,

    "code_extensions": [
        ".py", ".java", ".kt", ".js", ".jsx", ".ts", ".tsx",
        ".c", ".cpp", ".h", ".hpp", ".cs", ".go", ".rs", ".rb", ".php",
        ".m", ".dart", ".swift", ".sh", ".ps1", ".sql"
    ],
    "text_extensions": [
        ".md", ".txt", ".json", ".yaml", ".yml", ".toml", ".xml",
        ".gradle", ".properties", ".ini", ".cfg",
        ".html", ".css", ".sdf", ".urdf", ".launch"
    ],

    "voice": {
        "stt_engine": "faster_whisper",
        "stt_model": "small",
        "stt_compute_type": "int8",
        "stt_beam_size": 5,
        "stt_vocabulary_prompt": true,
        "stt_vocabulary": ["Asia", "ROADMAP", "ROADMAP.md", "Bolitabot", "bloc de notas", "proyecto activo",
                           "Ollama", "Gemini", "Whisper", "Piper", "pytest"],
        "language": "es",
        "tts_engine": "piper",
        "tts_voice": "es_MX-claude-high",
        "tts_speaker": null,
        "models_dir": "data/models",
        "voices_dir": "data/voices",
        "vad_threshold": 0.5,
        "silence_ms": 800,
        "max_seconds": 30,
        "start_timeout_s": 8,
        "min_speech_ms": 96
    },

    "rag": {
        "min_coverage": 0.3,
        "max_distance": 392.0
    },

    "reflection": {
        "summary_timeout_s": 30,
        "summary_idle_s": 3,
        "memory_review_timeout_s": 60
    },

    "answer_limits": {
        "explain_file": {"words": 150, "tokens": 450},
        "summarize_file": {"words": 100, "tokens": 300},
        "chat": {"tokens": 350, "detail_tokens": 1500, "voice_tokens": 150},
        "session_summary": {"tokens": 120}
    },

    "context_limits": {
        "summarize_file": 6000,
        "explain_file": 8000,
        "review_file": 10000,
        "generate_code_file": 12000,
        "review_project_file": 3000,
        "review_project_files": 15,
        "debug_project_tokens": 6000,
        "summarize_folder": {"max_files": 12, "max_chars_per_file": 1200},
        "save_project_summary": {"max_files": 15, "max_chars_per_file": 1500},
        "map_project": {"max_files": 30, "max_chars_per_file": 800},
        "generate_code_project": {"max_files": 25, "max_chars_per_file": 800}
    }
}
